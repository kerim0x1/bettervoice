# BetterVoice reads settings from %APPDATA%\BetterVoice\.env, which the setup
# and settings window write for you. For development, a .env in the repository
# root works too; real environment variables win over both.

# API keys for the cloud engines you use (the offline engine needs none)
DEEPGRAM_API_KEY=paste_your_key_here
# ELEVENLABS_API_KEY=
# OPENROUTER_API_KEY=

# DICTATE_ENGINE=local          # local, deepgram, elevenlabs, openrouter
# DICTATE_LANGUAGE=multi        # multi = automatic, or de en fr es it pt nl pl tr ru zh ja ar
# DICTATE_LOCAL_MODEL=auto      # auto, base, small, large-v3-turbo
# DICTATE_LOCAL_UNLOAD=1        # 1 = free the offline model 5 minutes after the last dictation
# DICTATE_POLISH=0              # 1 = AI Polish (needs OPENROUTER_API_KEY)
# DEEPGRAM_MODEL=nova-3
# ELEVENLABS_MODEL=scribe_v2
# OPENROUTER_MODEL=google/gemini-3.8-flash          # any model with audio input
# OPENROUTER_POLISH_MODEL=google/gemini-3.5-flash-lite
