# Auto detect text files and perform LF normalization
* text=auto

# Keep source, docs and config LF in the repository and working tree
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.svg text eol=lf
*.iss text eol=lf
.env.example text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

# Binary assets
*.png binary
*.ico binary
*.wav binary
